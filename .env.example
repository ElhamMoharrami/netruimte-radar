# ==============================================================================
# Netruimte Radar — environment variables
#
# Copy to `.env` and fill in the values you actually need.
# The system MUST boot with all AI/Apify/n8n values missing (demo mode).
# ==============================================================================

# --- Runtime mode --------------------------------------------------------------
# When true the API prefers demo providers (DemoSourceDiscoveryProvider,
# DemoGridContextProvider) and disables outbound actions.
DEMO_MODE=true

# --- API server ----------------------------------------------------------------
API_PORT=8787
API_HOST=127.0.0.1

# --- Database provider --------------------------------------------------------
# Which persistence adapter the API uses.
#
# Values:
#   sqlite       → node:sqlite against SQLITE_PATH (default; local dev / tests)
#   turso        → @libsql/client against TURSO_DATABASE_URL (production)
#   (unset)      → auto: 'turso' if TURSO_DATABASE_URL is set, else 'sqlite'
#
# Netlify production MUST use `turso` (or leave unset with TURSO_DATABASE_URL
# set) because in-memory node:sqlite does not survive Netlify Function cold
# starts — every scan would land in an ephemeral DB that the next dashboard
# request cannot see.
DATABASE_PROVIDER=sqlite

# --- SQLite (local dev / tests) -----------------------------------------------
# File path (relative to the api package) or ":memory:". Ignored when
# DATABASE_PROVIDER=turso.
SQLITE_PATH=../../data/netruimte-radar.db

# --- Turso / libSQL (production) ----------------------------------------------
# Create a database at https://turso.tech and paste the URL + auth token here.
# The URL uses the libsql:// scheme; the auth token is a JWT scoped to that db.
# On Netlify these are set via Site configuration → Environment variables and
# are never exposed to the frontend bundle.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Evidence extraction provider ---------------------------------------------
# Which extractor drives evidence extraction. Rule-based is always the
# fallback; whichever AI provider is selected, any request-time failure
# degrades cleanly to `rule-based` and the pipeline keeps running.
#
# Values:
#   rules      → skip AI entirely, use RuleBasedEvidenceExtractor
#   anthropic  → AnthropicEvidenceExtractor  (requires ANTHROPIC_API_KEY)
#   openai     → OpenAIEvidenceExtractor     (requires OPENAI_API_KEY)
#   gemini     → GeminiEvidenceExtractor     (requires GEMINI_API_KEY)
#   (unset)    → auto: whichever *_API_KEY is present, preferring anthropic
AI_PROVIDER=rules

# --- Anthropic / Claude -------------------------------------------------------
# Missing key with AI_PROVIDER=anthropic degrades cleanly to rule-based.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# --- OpenAI -------------------------------------------------------------------
# Uses Structured Outputs (`response_format: json_schema`, strict mode).
# Missing key with AI_PROVIDER=openai degrades cleanly to rule-based.
OPENAI_API_KEY=token
OPENAI_MODEL=gpt-4o-mini
# Optional — set to use Azure OpenAI or an OpenAI-compatible proxy.
OPENAI_BASE_URL=

# --- Google Gemini ------------------------------------------------------------
# Uses `responseMimeType=application/json` + `responseSchema`.
# Missing key with AI_PROVIDER=gemini degrades cleanly to rule-based.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Apify (optional) ----------------------------------------------------------
# Real Apify actor for source discovery. Missing token => DemoSourceDiscoveryProvider.
APIFY_TOKEN=token
APIFY_ACTOR_ID=token
APIFY_DATASET_ID=
# Comma-separated URLs the actor should crawl each run. Used as the actor
# input when APIFY_ACTOR_INPUT is not set. Empty list = actor runs with an
# empty input (only useful for actors that discover URLs themselves).
APIFY_START_URLS=
# Raw JSON body sent as the actor input; overrides APIFY_START_URLS. Set
# this only when you need actor-specific fields the auto-built body
# (safe website-content-crawler defaults) does not cover.
APIFY_ACTOR_INPUT=

# --- Scheduled runs ------------------------------------------------------------
# Shared secret expected on `X-Service-Token` for POST /api/runs/scheduled.
# Missing => scheduled endpoint is 401 for everyone (endpoint is disabled).
SERVICE_TOKEN=

# --- n8n (optional) ------------------------------------------------------------
# The ONE production webhook URL for orchestrated autonomous actions. All
# action types (create_dossier, notify_stakeholder, request_grid_verification)
# POST to this same URL; the n8n workflow reads `actionType` from the JSON
# body to route internally.
#
# Example:
#   https://<workspace>.app.n8n.cloud/webhook/netruimte-radar-actions
#
# NEVER paste an n8n editor URL, a test webhook URL, or a `base` URL — the
# dispatcher posts to this string verbatim. Missing => actions are logged
# but not executed.
#
# N8N_BASE_URL is DEPRECATED — the previous code derived per-action paths
# from a base URL (`/webhook/<actionType>`), which returned 404 in
# production because n8n workflows don't expose a webhook per action type.
# If N8N_BASE_URL is set and N8N_ACTION_WEBHOOK_URL is not, the API
# starts with automation DISABLED and /api/wiring surfaces the reason.
N8N_ACTION_WEBHOOK_URL=

# Optional shared secret sent as the `x-n8n-token` header. Never placed
# in the URL. Configure the same value on your n8n workflow's auth check.
N8N_WEBHOOK_TOKEN=
# Comma-separated allowlist of recipient identifiers (email/slack handle) that
# `notify_stakeholder` actions can be sent to. Enforced by the API in code —
# empty list means notify_stakeholder never fires, no matter what the model
# suggests. NEVER put a scraped business address here without explicit consent.
NOTIFICATION_ALLOWLIST=

# --- Grid context -------------------------------------------------------------
# Which grid-congestion provider drives GridContextProvider lookups.
#
# Values:
#   demo          → hardcoded city-level table (deterministic, offline)
#   netbeheer-nl  → live PDOK Locatieserver geocoding + committed
#                   Netbeheer Nederland Capaciteitskaart snapshot
#                   (see packages/core/src/grid/netbeheerNlSnapshot.ts).
#                   Falls back to `unknown` for any gemeente not in the
#                   snapshot rather than guessing.
#   (unset/auto)  → 'demo' when DEMO_MODE=true, else 'netbeheer-nl'
GRID_PROVIDER=
